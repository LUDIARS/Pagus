{
  "name": "pagus",
  "private": true,
  "version": "0.0.0",
  "description": "Pagus — AI村: LLM 駆動の創発的村シミュレーション",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @pagus/sim build && pnpm --filter @pagus/server build",
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "pagus:config": "pnpm --filter @pagus/server pagus:config"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
